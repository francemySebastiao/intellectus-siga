				<textElement textAlignment="Justified" markup="html">
					<font fontName="Serif" size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["Mais se certifica que concluiu o referido curso aos "+$F{DATA_CONCLUSAO}+" com a média final de "+$F{MEDIA_EXTENSO}+"."]]></textFieldExpression>
			</textField>
			<textField>
