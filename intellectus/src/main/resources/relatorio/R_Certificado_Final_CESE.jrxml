				</textElement>
				<textFieldExpression><![CDATA["Luanda, "+$P{data}+"."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement isPrintRepeatedValues="false" x="34" y="68" width="265" height="18" isRemoveLineWhenBlank="true" uuid="50da271e-3b2c-41d3-8dbb-d2d8389ea421"/>
				<textElement verticalAlignment="Top">
					<font fontName="Serif" size="10"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["Numero de Matrícula: "+$F{NUMERO_DE_ALUNO}]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="34" y="67" width="485" height="1" uuid="bfa17d43-0b79-4ec9-8235-77a9eef862b6"/>
				<graphicElement>
