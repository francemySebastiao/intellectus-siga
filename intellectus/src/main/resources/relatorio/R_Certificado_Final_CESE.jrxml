<?xml version="1.0" encoding="UTF-8"?>
<!-- Created with Jaspersoft Studio version 6.6.0.final using JasperReports Library version 6.6.0  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="R_Certificado_Intermedio" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isFloatColumnFooter="true" uuid="1a9393c7-bfd7-45c4-8a08-a36bcde105ba">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="20"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Sample DB"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="numero_matricula" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="condicao" class="java.lang.String"/>
	<parameter name="data" class="java.lang.String"/>
	<parameter name="numero_pedido" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[select  

 

		RD.numero_declaracao NumeroPedido
		,A.NOME,
		A.SEXO,
		A.NOME_DO_PAI,
		A.NOME_DA_MAE,
		A.NUMERO_DOCUMENTO_IDENTIFICACAO,
		A.DATA_EMISSAO_IDENTIDADE,
		A.ARQUIVO_IDENTIFICACAO,
		A.DATA_NASCIMENTO,
		PV.PROVINCIA,
		CS.GRAU,
		CS.DESCRICAO ESPECIALIDADE,
		 CASE
				WHEN CS.ID IN (23,24) THEN 'Engenharia Informática'
				WHEN CS.ID IN (21,22) THEN 'Direito'
				WHEN CS.ID IN (25,26) THEN 'Gestão de Recursos Humanos'
				WHEN CS.ID IN (27) THEN 'Comunicação, Marketing e Publicidade'
				WHEN CS.ID IN (28,29,30) THEN 'Gestão de Empresas'
		ELSE
		CS.DESCRICAO
		END CURSO_real,
		V.DISCIPLINA,
		V.NOTA_FINAL,
		A.NUMERO_DE_ALUNO,
		FD.CARGO,
		FD.FACULDADE NOME,
		FD.TITULO,
		FD.RESPONSAVEL,
		V.TOTAL_DISCIPLINAS,
		V.ano_curricular,
		V.ano_lectivo,
		A.DATA_FIM_DO_CURSO,
		CASE
                --WHEN AN.MEDIA_FINAL IS NULL THEN '---'
	            WHEN A.MEDIA_FINAL = 0 THEN '(Zero)'
                WHEN A.MEDIA_FINAL = 1 THEN '(Um)'
                WHEN A.MEDIA_FINAL = 2 THEN '(Dois)'
                WHEN A.MEDIA_FINAL = 3 THEN '(Três)'
                WHEN A.MEDIA_FINAL = 4 THEN '(Quatro)'
                WHEN A.MEDIA_FINAL = 5 THEN '(Cinco)'
                WHEN A.MEDIA_FINAL = 6 THEN '(Seis)'
                WHEN A.MEDIA_FINAL = 7 THEN '(Sete)'
                WHEN A.MEDIA_FINAL = 8 THEN '(Oito)'
                WHEN A.MEDIA_FINAL = 9 THEN '(Nove)'
                WHEN A.MEDIA_FINAL = 10 THEN '(Dez)'
                WHEN A.MEDIA_FINAL = 11 THEN '(Onze)'
                WHEN A.MEDIA_FINAL = 12 THEN '(Doze)'
                WHEN A.MEDIA_FINAL = 13 THEN '(Treze)'
                WHEN A.MEDIA_FINAL = 14 THEN '(Catorze)'
                WHEN A.MEDIA_FINAL = 15 THEN '(Quinze)'
                WHEN A.MEDIA_FINAL = 16 THEN '(Dezasseis)'
                WHEN A.MEDIA_FINAL = 17 THEN '(Dezassete)'
                WHEN A.MEDIA_FINAL = 18 THEN '(Dezoito)'
                WHEN A.MEDIA_FINAL = 19 THEN '(Dezanove)'
                WHEN A.MEDIA_FINAL = 20 THEN '(Vinte)'	
		END MEDIA_EXTENSO
		,CONCAT(DBO.NumeroPorExtenso(DAY(A.data_fim_do_curso),MONTH(A.data_fim_do_curso)),' de ',DBO.AnoPorExtenso(YEAR(A.data_fim_do_curso))) DATA_CONCLUSAO
		 from V_CERTIFICADO_INTERMEDIO V inner join t_aluno A ON (V.NUMERO = A.NUMERO_DE_ALUNO)
										 INNER JOIN t_registro_documentos  RD ON (RD.CODIGO_ALUNO = A.ID)
										  INNER JOIN T_PROVINCIA PV ON (PV.ID = A.CODIGO_PROVINCIA_NASCIMENTO)
										  INNER JOIN T_CURSO CS      ON (CS.ID = A.CODIGO_CURSO)
										  INNER JOIN T_FACULDADE FD  ON (FD.ID = CS.CODIGO_FACULDADE)

										  where 
										  CS.GRAU='CESE'
										  AND A.NUMERO_DE_ALUNO= $P{numero_matricula} 
										  AND RD.numero_declaracao= $P{numero_pedido}
										  order by V.ano_curricular]]>
	</queryString>
