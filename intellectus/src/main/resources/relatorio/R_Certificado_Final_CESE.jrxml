			<textField>
				<reportElement x="34" y="89" width="487" height="42" uuid="b008809d-dd1e-4d55-a6a7-9b077061cb6b"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="Serif" size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["Por ser verdade e ter sido pedido, mandou-se passar o presente Certificado, que vai assinado e autenticado com o selo branco em uso nesta Universidade."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="34" y="132" width="358" height="20" uuid="662b9b2c-31ab-4ddf-a28a-1931a7245c26">
					<printWhenExpression><![CDATA[$P{condicao}.equals("1")]]></printWhenExpression>
