	</background>
	<title>
		<band height="275">
			<textField>
				<reportElement x="34" y="164" width="487" height="111" uuid="eb6897ca-8c66-4631-8d8d-ef2e468c69ae"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle" markup="html">
					<font fontName="Serif" size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["Face aos arquivos existentes nesta Universidade, instituída pelo Decreto n.º 23/07, de 7 de Maio, certifica-se que "+"<b>"+$F{NOME}+"</b>"+", "+($F{SEXO}.equals("F")? "filha": $F{SEXO}.equals("M")? "filho": $F{SEXO}.equals("ANUAL")?"Anual": "-sem informação-")+" de "+$F{NOME_DO_PAI}+" e de "+$F{NOME_DA_MAE}+($F{SEXO}.equals("F")? ", nascida a ": $F{SEXO}.equals("M")? ", nascido a ": $F{SEXO}.equals("ANUAL")?"Anual": "-sem informação-")+" "+new java.text.SimpleDateFormat("dd/MM/yyyy").format($F{DATA_NASCIMENTO})+", natural de "+$F{PROVINCIA}+($F{SEXO}.equals("F")? ", portadora do Bilhete de Identidade n.º ": $F{SEXO}.equals("M")? ", portador do Bilhete de Identidade n.º ": $F{SEXO}.equals("ANUAL")?"Anual": "else SQL Query")+$F{NUMERO_DOCUMENTO_IDENTIFICACAO}+", emitido aos "+new java.text.SimpleDateFormat("dd/MM/yyyy").format($F{DATA_EMISSAO_IDENTIDADE})+" pelo arquivo de "+$F{ARQUIVO_IDENTIFICACAO}+", obteve aprovação nas seguintes disciplinas que constituem o curso de Estudos Tecnológicos em "+$F{CURSO_real}+":"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="34" y="150" width="487" height="24" uuid="a9d4aa5a-f68c-47a7-a38d-177cac34cdd1"/>
				<textElement textAlignment="Center" verticalAlignment="Bottom">
					<font fontName="Serif" size="14" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["CERTIFICADO FINAL"]]></textFieldExpression>
			</textField>
		</band>
	</title>
	<detail>
		<band height="14" splitType="Prevent">
			<textField>
				<reportElement x="34" y="0" width="313" height="14" uuid="27b8d369-544e-4a12-943e-9d32a3e199e5"/>
				<textElement verticalAlignment="Top">
					<font fontName="Serif" size="11"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{DISCIPLINA}]]></textFieldExpression>
			</textField>
			<elementGroup>
				<textField pattern="##" isBlankWhenNull="true">
					<reportElement x="348" y="0" width="96" height="14" uuid="565afd4a-5247-4092-b497-73b9b33e9284"/>
					<textElement verticalAlignment="Top">
						<font fontName="Serif" size="11"/>
					</textElement>
					<textFieldExpression><![CDATA[(new DecimalFormat("##")).format($F{NOTA_FINAL})  +" "+(
    $F{NOTA_FINAL} == 1  ?
    "(Um)" :
    $F{NOTA_FINAL} == 2 ?
    "(Dois)" :
   $F{NOTA_FINAL} == 3 ?
    "(Tres)" :
    $F{NOTA_FINAL} == 4 ?
    "(Quatro)" :
    $F{NOTA_FINAL} == 5 ?
    "(Cinco)" :
    $F{NOTA_FINAL} == 6 ?
    "(Seis)" :
    $F{NOTA_FINAL} == 7 ?
    "(Sete)" :
    $F{NOTA_FINAL} == 8 ?
    "(Oito)" :
    $F{NOTA_FINAL} == 9 ?
    "(Nove)" :
    $F{NOTA_FINAL} == 10 ?
    "(Dez)" :
    $F{NOTA_FINAL} == 11 ?
    "(Onze)" :
    $F{NOTA_FINAL} == 12 ?
    "(Doze)" :
    $F{NOTA_FINAL} == 13 ?
    "(Treze)" :
    $F{NOTA_FINAL} == 14 ?
    "(Catorze)" :
    $F{NOTA_FINAL} == 15 ?
    "(Quinze)" :
    $F{NOTA_FINAL} == 16 ?
    "(Dezasseis)" :
    $F{NOTA_FINAL} == 17 ?
    "(Dezassete)" :
    $F{NOTA_FINAL} == 18 ?
    "(Dezoito)" :
    $F{NOTA_FINAL} == 19?
    "(Dezanove)" :
    $F{NOTA_FINAL} == 20 ?
    "(Vinte)" :
    "Sem Nota")]]></textFieldExpression>
				</textField>
			</elementGroup>
			<staticText>
				<reportElement x="441" y="0" width="45" height="14" uuid="336ee767-aecb-4adc-8abb-7a71a0129b00"/>
				<textElement textAlignment="Center" verticalAlignment="Top">
					<font fontName="Serif" size="11"/>
				</textElement>
				<text><![CDATA[Valores]]></text>
			</staticText>
			<textField>
				<reportElement x="486" y="0" width="53" height="14" uuid="f32b63d8-568a-49d2-a183-32cf25e79391"/>
				<textElement textAlignment="Left" verticalAlignment="Top">
					<font fontName="Serif" size="11"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{ano_lectivo} == 23 ? "2023/2024" : $F{ano_lectivo} == 22 ? "2022/2023" :$F{ano_lectivo} == 21 ? "2021/2022" :$F{ano_lectivo} == 20 ? "2020" : $F{ano_lectivo} == 19 ? "2019" : $F{ano_lectivo} == 18 ? "2018" : ""
]]></textFieldExpression>
			</textField>
		</band>
	</detail>
