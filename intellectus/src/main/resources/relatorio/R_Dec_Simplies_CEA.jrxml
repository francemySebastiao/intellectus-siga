					<font fontName="SansSerif" size="10"/>
				</textElement>
				<textFieldExpression><![CDATA["Professor Doutor Juan Silvio Cabrera Albert"]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="44" y="-6" width="448" height="233" uuid="2a5e305d-9aa4-4f27-8089-d56c955e1d07"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle" markup="html">
					<font fontName="SansSerif" size="12" isPdfEmbedded="true"/>
					<paragraph lineSpacing="Double"/>
				</textElement>
				<textFieldExpression><![CDATA["Juan Silvio Cabrera, Coordenador Adjunto dos Cursos de Estudos Avançados (CEA) do Instituto Politecnico Gregorio Semedo, declara que "+$F{t_aluno_nome}+($F{t_aluno_sexo}.equals("F")? ", portadora do Bilhete de Identidade n.º ": $F{t_aluno_sexo}.equals("M")? ", Portador do Bilhete de Identidade n.º ": $F{t_aluno_sexo}.equals("null")?"--": "--")+$F{t_aluno_numero_documento_identificacao}+" esta matriculado e frequenta, com o N.º "+$F{t_matricula_numero_de_aluno}+" no Programa de Curso de Estudos Avançados em "+$F{descricao}+", no ano lectivo "+$F{t_ano_lectivo_ano_lectivo}+"."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="44" y="267" width="372" height="20" uuid="c1e693da-ff64-472d-8109-d5c04b88d875">
					<printWhenExpression><![CDATA[$P{condicao}.equals("1")]]></printWhenExpression>
				</reportElement>
				<textElement>
					<font fontName="SansSerif" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["Lubango ,"+$P{data}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="44" y="273" width="448" height="20" uuid="ee17963f-270b-4452-bf72-9ead4a5c7a50">
					<printWhenExpression><![CDATA[$P{condicao}.equals("2")]]></printWhenExpression>
				</reportElement>
