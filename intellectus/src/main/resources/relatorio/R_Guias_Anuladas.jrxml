	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="MeuPC"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="data1" class="java.util.Date"/>
	<parameter name="data2" class="java.util.Date"/>
	<parameter name="condicao" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
     V_DOCUMENTOS_ANULADOS."DATA_ANULADA" AS V_DOCUMENTOS_ANULADOS_DATA_ANULADA,
     V_DOCUMENTOS_ANULADOS."USUARIO_ANULOU" AS V_DOCUMENTOS_ANULADOS_USUARIO_ANULOU,
     V_DOCUMENTOS_ANULADOS."UTILIZADOR_ANULOU" AS V_DOCUMENTOS_ANULADOS_UTILIZADOR_ANULOU,
     V_DOCUMENTOS_ANULADOS."N_DOCUMENTO" AS V_DOCUMENTOS_ANULADOS_N_DOCUMENTO,
     V_DOCUMENTOS_ANULADOS."MOTIVO" AS V_DOCUMENTOS_ANULADOS_MOTIVO,
     V_DOCUMENTOS_ANULADOS."EMOLUMENTO" AS V_DOCUMENTOS_ANULADOS_EMOLUMENTO,
     V_DOCUMENTOS_ANULADOS."NOME" AS V_DOCUMENTOS_ANULADOS_NOME,
     V_DOCUMENTOS_ANULADOS."VALOR" AS V_DOCUMENTOS_ANULADOS_VALOR,
     V_DOCUMENTOS_ANULADOS."NOME_INSTITUICAO" AS V_DOCUMENTOS_ANULADOS_NOME_INSTITUICAO,
     V_DOCUMENTOS_ANULADOS."INSTITUICAO_ID" AS V_DOCUMENTOS_ANULADOS_INSTITUICAO_ID,
     V_DOCUMENTOS_ANULADOS."LOGO_MARCA" AS V_DOCUMENTOS_ANULADOS_LOGO_MARCA,
     V_DOCUMENTOS_ANULADOS."NUMERO_DE_ALUNO" AS V_DOCUMENTOS_ANULADOS_NUMERO_DE_ALUNO,
     V_DOCUMENTOS_ANULADOS."ANO_LECTIVO" AS V_DOCUMENTOS_ANULADOS_ANO_LECTIVO,
     V_DOCUMENTOS_ANULADOS."GRUPO_OWNER" AS V_DOCUMENTOS_ANULADOS_GRUPO_OWNER
FROM
     "dbo"."V_DOCUMENTOS_ANULADOS" V_DOCUMENTOS_ANULADOS

where V_DOCUMENTOS_ANULADOS."DATA_ANULADA" between $P{data1} and $P{data2}
order by V_DOCUMENTOS_ANULADOS."NOME"]]>
	</queryString>
	<field name="V_DOCUMENTOS_ANULADOS_DATA_ANULADA" class="java.sql.Date"/>
	<field name="V_DOCUMENTOS_ANULADOS_USUARIO_ANULOU" class="java.lang.String"/>
