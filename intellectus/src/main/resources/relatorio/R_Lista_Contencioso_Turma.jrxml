	<parameter name="cod_curso" class="java.lang.String"/>
	<parameter name="cod_turma" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
     V_LISTAGEM_CONTENCIOSO."NUMERO_DE_ALUNO" AS V_LISTAGEM_CONTENCIOSO_NUMERO_DE_ALUNO,
     V_LISTAGEM_CONTENCIOSO."NOME_ALUNO" AS V_LISTAGEM_CONTENCIOSO_NOME_ALUNO,
     V_LISTAGEM_CONTENCIOSO."CONTENCIOSO" AS V_LISTAGEM_CONTENCIOSO_CONTENCIOSO,
     V_LISTAGEM_CONTENCIOSO."CODIGO_CURSO" AS V_LISTAGEM_CONTENCIOSO_CODIGO_CURSO,
     V_LISTAGEM_CONTENCIOSO."CURSO" AS V_LISTAGEM_CONTENCIOSO_CURSO,
     V_LISTAGEM_CONTENCIOSO."SEMESTRE" AS V_LISTAGEM_CONTENCIOSO_SEMESTRE,
     V_LISTAGEM_CONTENCIOSO."CODIGO_TURMA" AS V_LISTAGEM_CONTENCIOSO_CODIGO_TURMA,
     V_LISTAGEM_CONTENCIOSO."TURMA" AS V_LISTAGEM_CONTENCIOSO_TURMA,
     V_LISTAGEM_CONTENCIOSO."TOTAL_DIVIDA" AS V_LISTAGEM_CONTENCIOSO_TOTAL_DIVIDA,
     V_LISTAGEM_CONTENCIOSO."ANO_CURRICULAR" AS V_LISTAGEM_CONTENCIOSO_ANO_CURRICULAR,
     V_LISTAGEM_CONTENCIOSO."GRUPO_OWNER" AS V_LISTAGEM_CONTENCIOSO_GRUPO_OWNER,
     V_LISTAGEM_CONTENCIOSO."CODIGO_ANO_LECTIVO" AS V_LISTAGEM_CONTENCIOSO_CODIGO_ANO_LECTIVO,
     V_LISTAGEM_CONTENCIOSO."ANO_LECTIVO" AS V_LISTAGEM_CONTENCIOSO_ANO_LECTIVO,
     V_LISTAGEM_CONTENCIOSO."LOGO_MARCA" AS V_LISTAGEM_CONTENCIOSO_LOGO_MARCA,
     V_LISTAGEM_CONTENCIOSO."GRAU" AS V_LISTAGEM_CONTENCIOSO_GRAU
FROM
     "dbo"."V_LISTAGEM_CONTENCIOSO" V_LISTAGEM_CONTENCIOSO
WHERE
     V_LISTAGEM_CONTENCIOSO."CODIGO_ANO_LECTIVO" = $P{cod_ano}
     and V_LISTAGEM_CONTENCIOSO."CODIGO_CURSO" = $P{cod_curso}
     and V_LISTAGEM_CONTENCIOSO."CODIGO_TURMA" = $P{cod_turma}]]>
	</queryString>
