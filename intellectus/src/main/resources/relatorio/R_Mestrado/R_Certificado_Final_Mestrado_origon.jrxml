				</textElement>
				<text><![CDATA[DISCIPLINA COM APROVEITAMENTO]]></text>
			</staticText>
			<textField>
				<reportElement isPrintRepeatedValues="false" x="54" y="141" width="481" height="108" isRemoveLineWhenBlank="true" uuid="ae292cb9-e3f7-4f8e-b548-dd49ea63e497">
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
					<property name="com.jaspersoft.studio.unit.y" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top" markup="html">
					<font fontName="Serif" size="11"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["Face aos arquivos existentes nesta Universidade, certifica-se que "+"<b>"+$F{NOME}+"</b>"+", "+($F{SEXO}.equals("FEMININO")? "filha": $F{SEXO}.equals("MASCULINO")? "filho":"")+" de "+$F{NOME_DO_PAI}+" e de "+$F{NOME_DA_MAE}+", "+($F{SEXO}.equals("FEMININO")? "portadora do Bilhete de Identidade n.º ": $F{SEXO}.equals("MASCULINO")? "portador do Bilhete de Identidade n.º ": "")+$F{NUMERO_DOCUMENTO_IDENTIFICACAO}+", emitido aos "+$F{DATA_EMISSAO_IDENTIDADE}+" pelo arquivo de "+$F{MUNICIPIO}+", "+($F{SEXO}.equals("FEMININO")? "nascida a ": $F{SEXO}.equals("MASCULINO")? "nascido a ": "")+$F{DATA_NASCIMENTO}+", natural d"+$F{PROVINCIA_CONCORDANCIA}+"  "+$F{PROVINCIA}+", obteve aprovação nas seguintes disciplinas que correspondem ao plano curricular do curso de Mestrado em "+"<b>"+$F{CURSO}+"</b>"+ ($F{CURSO}.equals("Comunicação, Marketing e Publicidade")? ", ":",  na especialidade em "+"<b>"+$F{ESPECIALIDADE})+"</b>"+", aprovado pelo Decreto nº "+$F{DECRETO}+"."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="412" y="272" width="20" height="6" uuid="e88392e7-9f05-4dbc-9540-4371173d5fd8">
