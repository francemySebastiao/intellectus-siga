	<summary>
		<band height="714" splitType="Immediate">
			<property name="com.jaspersoft.studio.unit.height" value="px"/>
			<line>
				<reportElement x="41" y="265" width="481" height="1" forecolor="#FFFFFF" uuid="28b315b7-c7a4-4603-b11e-365c89d68190"/>
				<graphicElement>
					<pen lineWidth="1.0"/>
				</graphicElement>
			</line>
			<staticText>
				<reportElement x="53" y="52" width="479" height="13" uuid="e691bd31-6166-48a1-8583-befef51e7861"/>
				<textElement textAlignment="Left" verticalAlignment="Top">
					<font fontName="Serif" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[( )Escala: Suficiente(10 a 13), Bom (14 a 15), Bom com distinção(16 e 17) e Muito bom (18 a 20).]]></text>
			</staticText>
			<staticText>
				<reportElement x="53" y="39" width="479" height="13" uuid="591b35de-f186-4a18-9b2a-9e6ce5d4ae12"/>
				<textElement textAlignment="Left" verticalAlignment="Top">
					<font fontName="Serif" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[( )Cada Unidade de Crédito corresponde a 15 horas.]]></text>
			</staticText>
			<textField>
				<reportElement isPrintRepeatedValues="false" x="53" y="86" width="478" height="38" isRemoveLineWhenBlank="true" uuid="3510e640-803f-4ce4-b8d3-a29fa8a6976e"/>
				<textElement verticalAlignment="Top">
					<font fontName="Serif" size="10"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["Mas certifica-se que concluiu o referido Mestrado aos "+$F{DATA_CONCLUSAO}+" com a média aritmetica de "+$F{MEDIA_FINAL}+" "+$F{MEDIA_EXTENSO}+" valores."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement isPrintRepeatedValues="false" x="41" y="330" width="259" height="18" isRemoveLineWhenBlank="true" uuid="8f666ab0-9852-4762-a9c9-014ddbdb01eb"/>
				<textElement verticalAlignment="Top">
					<font fontName="Serif" size="10"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["Número de matrícula: "+ ($F{NUMERO_DE_ALUNO})]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="40" y="363" width="478" height="66" uuid="71e86a07-d80b-4cf3-bf5e-e62e11570c3c"/>
				<textElement markup="html">
					<font fontName="Serif"/>
				</textElement>
				<textFieldExpression><![CDATA["Por ser verdade e ter sido pedido, mandou-se passar o presente Certificado, que vai assinado e autenticado com o carimbo a selo branco em uso nesta Universidade."+"</b>"+"<br/>"+"<br/>"+"<b>"+"Luanda, "+$P{data}+"."+"</b>"]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="40" y="456" width="155" height="20" uuid="1a51d1e6-8b33-4529-aefd-e01b8cf3f6b9">
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
				</reportElement>
				<textElement textAlignment="Center">
					<font size="9"/>
				</textElement>
				<text><![CDATA[O Chefe dos Serviços Académicos]]></text>
			</staticText>
			<staticText>
				<reportElement x="194" y="541" width="168" height="20" uuid="df2a1c58-eec7-436f-b155-893c381ad728">
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
				</reportElement>
				<textElement textAlignment="Center">
					<font size="9"/>
				</textElement>
				<text><![CDATA[O Reitor]]></text>
