	<summary>
		<band height="387" splitType="Immediate">
			<line>
				<reportElement x="41" y="0" width="481" height="1" uuid="e22d7aea-57d7-4ac6-ac5a-2f981bab55ac"/>
				<graphicElement>
					<pen lineWidth="1.0"/>
				</graphicElement>
			</line>
			<textField>
				<reportElement isPrintRepeatedValues="false" x="41" y="1" width="259" height="18" isRemoveLineWhenBlank="true" uuid="87a50482-6168-43af-ad68-b6d1a6611e0a"/>
				<textElement verticalAlignment="Top">
					<font fontName="Serif" size="10"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["Número: "+ ($F{NUMERO_ALUNO})]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="41" y="19" width="481" height="111" uuid="aa207c25-8b0d-4157-9f21-7da0922c1342"/>
				<textElement textAlignment="Justified" verticalAlignment="Top" rotation="None" markup="html">
					<font fontName="Serif" size="10"/>
					<paragraph lineSpacing="1_1_2"/>
				</textElement>
				<textFieldExpression><![CDATA["Por ser verdade e ter sido pedido, mandei passar o presente Certificado, onde constam as classificações obtidas correspondentes à aprovação em "+$V{REPORT_COUNT}+" disciplinas, do total"+" de "+$F{QUANTIDADE_CADEIRAS}+" que correspondem ao plano curricular, que vai assinado e autenticado com o carimbo a óleo em uso nesta Universidade."+"<br/>"+"<br/>"+"Luanda, "+$P{data}]]></textFieldExpression>
			</textField>
		</band>
	</summary>
</jasperReport>
