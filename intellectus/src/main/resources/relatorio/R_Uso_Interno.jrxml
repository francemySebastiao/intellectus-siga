	<queryString>
		<![CDATA[SELECT
     *,
     v_uso_interno."ID_ALUNO" AS v_uso_interno_ID_ALUNO,
     v_uso_interno."ARQUIVO_IDENTIFICACAO" AS v_uso_interno_ARQUIVO_IDENTIFICACAO,
     v_uso_interno."MORADA" AS v_uso_interno_MORADA,
     v_uso_interno."ATESTADO_MEDICO" AS v_uso_interno_ATESTADO_MEDICO,
     v_uso_interno."DATA_EMISSAO_DOCUMENTO" AS v_uso_interno_DATA_EMISSAO_DOCUMENTO,
     v_uso_interno."DATA_FIM_CURSO" AS v_uso_interno_DATA_FIM_CURSO,
     v_uso_interno."DATA_INATIVACAO" AS v_uso_interno_DATA_INATIVACAO,
     v_uso_interno."TIPO_DOCUMENTO" AS v_uso_interno_TIPO_DOCUMENTO,
     v_uso_interno."DATA_NASCIMENTO" AS v_uso_interno_DATA_NASCIMENTO,
     v_uso_interno."FIM_CURSO" AS v_uso_interno_FIM_CURSO,
     v_uso_interno."NOME" AS v_uso_interno_NOME,
     v_uso_interno."MEDIA_FINAL" AS v_uso_interno_MEDIA_FINAL,
     v_uso_interno."NOME_MAE" AS v_uso_interno_NOME_MAE,
     v_uso_interno."NOME_PAI" AS v_uso_interno_NOME_PAI,
     v_uso_interno."GENERO" AS v_uso_interno_GENERO,
     v_uso_interno."NUMERO_IDENTIFICACAO" AS v_uso_interno_NUMERO_IDENTIFICACAO,
     v_uso_interno."CURSO" AS v_uso_interno_CURSO,
     v_uso_interno."GRAU_ACADEMICO" AS v_uso_interno_GRAU_ACADEMICO,
     v_uso_interno."QUANTIDADE_CADEIRAS" AS v_uso_interno_QUANTIDADE_CADEIRAS,
     v_uso_interno."PROVINCIA" AS v_uso_interno_PROVINCIA,
     v_uso_interno."MUNICIPIO" AS v_uso_interno_MUNICIPIO,
     v_uso_interno."CARGO_DECANO" AS v_uso_interno_CARGO_DECANO,
     v_uso_interno."NOME_FACULDADE" AS v_uso_interno_NOME_FACULDADE,
     v_uso_interno."NOME_DECANO" AS v_uso_interno_NOME_DECANO,
     v_uso_interno."ID_INSTITUICAO" AS v_uso_interno_ID_INSTITUICAO,
     v_uso_interno."CARGO_VICE_DECANO" AS v_uso_interno_CARGO_VICE_DECANO,
     v_uso_interno."CHEFE_SERVICOS_ACADEMICOS" AS v_uso_interno_CHEFE_SERVICOS_ACADEMICOS,
     v_uso_interno."SECRETARIO_GERAL" AS v_uso_interno_SECRETARIO_GERAL,
     v_uso_interno."ID_DISCIPLINA" AS v_uso_interno_ID_DISCIPLINA,
     v_uso_interno."NUMERO_ALUNO" AS v_uso_interno_NUMERO_ALUNO,
     v_uso_interno."DISCIPLINA" AS v_uso_interno_DISCIPLINA,
     v_uso_interno."VALIDADA" AS v_uso_interno_VALIDADA,
     v_uso_interno."NOTA_FINAL" AS v_uso_interno_NOTA_FINAL,
     v_uso_interno."ID_ANO_LECTIVO" AS v_uso_interno_ID_ANO_LECTIVO,
     v_uso_interno."ANO_CURRICULAR" AS v_uso_interno_ANO_CURRICULAR,
     v_uso_interno."ANO_LECTIVO" AS v_uso_interno_ANO_LECTIVO,
     v_uso_interno."PODE_EQUIVALENCIA" AS v_uso_interno_PODE_EQUIVALENCIA,
     v_uso_interno."EQUIVALENCIA" AS v_uso_interno_EQUIVALENCIA
FROM
     "v_uso_interno" v_uso_interno
WHERE
     v_uso_interno."NUMERO_ALUNO" = $P{numero_matricula}
     order by v_uso_interno."ANO_CURRICULAR" ASC]]>
	</queryString>
