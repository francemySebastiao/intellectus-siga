	<title>
		<band height="124">
			<textField>
				<reportElement x="41" y="1" width="481" height="123" uuid="ab52c1e8-6421-4cfa-b016-e66ff2dd36f1"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle" markup="html">
					<font fontName="Serif" size="11"/>
					<paragraph lineSpacing="1_1_2"/>
				</textElement>
				<textFieldExpression><![CDATA["Face aos arquivos existentes nesta Universidade, instituída pelo Decreto Executivo n.º 23/07 de 07 de Maio, certifica-se que "+"<b>"+$F{NOME}+"</b>"+", "+($F{GENERO}.equals("FEMININO")? "filha": $F{GENERO}.equals("MASCULINO")? "filho": $F{GENERO}.equals("ANUAL")?"-sem informação-": "")+" de "+$F{NOME_PAI}+" e de "+$F{NOME_MAE}+", "+($F{GENERO}.equals("F")? "portadora do Bilhete de Identidade n.º ": $F{GENERO}.equals("MASCULINO")? "portador do Bilhete de Identidade n.º ": $F{GENERO}.equals("ANUAL")?"Anual": "")+$F{NUMERO_IDENTIFICACAO}+", emitido aos "+new java.text.SimpleDateFormat("dd/MM/yyyy").format($F{DATA_EMISSAO_DOCUMENTO})+" pelo arquivo de "+$F{MUNICIPIO}+", "+($F{GENERO}.equals("FEMININO")? "nascida a ": $F{GENERO}.equals("MASCULINO")? "nascido a " : $F{GENERO}.equals("ANUAL")? "-sem informação-": "")+" "+new java.text.SimpleDateFormat("dd/MM/yyyy").format($F{DATA_NASCIMENTO})+", natural da "+$F{ARQUIVO_IDENTIFICACAO}+"  "+$F{PROVINCIA}+", obteve as seguintes classificações no curso de "+ ($F{GRAU_ACADEMICO}.equals("LICENCIATURA")? "Licenciatura em ":"Mestrado em ")+"<b>"+$F{CURSO}+"<b>"+"."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="34" y="-1" width="497" height="17" uuid="17b6f2ce-75ed-4c10-ac97-97315dcdcea2"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Serif" size="12" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[($P{condicao}.equals("1") ?
    "USO INTERNO - SEM VALOR LEGAL" :
    $P{condicao}.equals("2") ?
    "USO INTERNO - SEM VALOR LEGAL" : "")]]></textFieldExpression>
			</textField>
		</band>
	</title>
	<detail>
		<band height="13" splitType="Immediate">
			<textField>
				<reportElement x="41" y="0" width="259" height="13" uuid="27b8d369-544e-4a12-943e-9d32a3e199e5"/>
				<textElement verticalAlignment="Top">
					<font fontName="Serif" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{DISCIPLINA}]]></textFieldExpression>
			</textField>
			<textField pattern="##" isBlankWhenNull="true">
				<reportElement x="301" y="0" width="76" height="13" uuid="565afd4a-5247-4092-b497-73b9b33e9284"/>
				<textElement verticalAlignment="Top">
					<font fontName="Serif" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA[(new DecimalFormat("##")).format($F{NOTA_FINAL})  +" "+(
    $F{NOTA_FINAL} == 1  ?
    "(Um)" :
    $F{NOTA_FINAL} == 2 ?
    "(Dois)" :
    $F{NOTA_FINAL} == 3 ?
    "(Tres)" :
   $F{NOTA_FINAL} == 4 ?
    "(Quatro)" :
    $F{NOTA_FINAL} == 5 ?
    "(Cinco)" :
    $F{NOTA_FINAL} == 6 ?
    "(Seis)" :
    $F{NOTA_FINAL} == 7 ?
    "(Sete)" :
    $F{NOTA_FINAL} == 8 ?
    "(Oito)" :
    $F{NOTA_FINAL} == 9 ?
    "(Nove)" :
    $F{NOTA_FINAL} == 10 ?
    "(Dez)" :
    $F{NOTA_FINAL} == 11 ?
    "(Onze)" :
    $F{NOTA_FINAL} == 12 ?
    "(Doze)" :
    $F{NOTA_FINAL} == 13 ?
    "(Treze)" :
    $F{NOTA_FINAL} == 14 ?
    "(Catorze)" :
    $F{NOTA_FINAL} == 15 ?
    "(Quinze)" :
    $F{NOTA_FINAL} == 16 ?
    "(Dezasseis)" :
    $F{NOTA_FINAL} == 17 ?
    "(Dezassete)" :
   $F{NOTA_FINAL}== 18 ?
    "(Dezoito)" :
    $F{NOTA_FINAL} == 19?
    "(Dezanove)" :
    $F{NOTA_FINAL} == 20 ?
    "(Vinte)" :
    "Sem Nota")]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="377" y="0" width="43" height="13" uuid="336ee767-aecb-4adc-8abb-7a71a0129b00"/>
				<textElement textAlignment="Center" verticalAlignment="Top">
					<font fontName="Serif" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Valores]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="418" y="0" width="42" height="13" uuid="47ccd505-8d2e-4fa9-bb72-0b051f6b691f"/>
				<textElement textAlignment="Center" verticalAlignment="Top">
					<font fontName="Serif" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{v_uso_interno_EQUIVALENCIA}==1 ? "a)" :$F{ANO_LECTIVO}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="460" y="0" width="63" height="13" uuid="58eb9b64-6ac5-445e-96ee-ae9183d14a1b"/>
				<textElement textAlignment="Right" verticalAlignment="Top">
					<font fontName="Serif" size="9"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{VALIDADA}.booleanValue()? "Validada" : "Não Validada"]]></textFieldExpression>
			</textField>
